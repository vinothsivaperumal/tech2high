{
  "name": "tech2high-portal",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev": "npm run dev:api & npm run dev:web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "start:web": "npm run start --workspace apps/web",
    "start": "npm run start:api & npm run start:web",
    "migrate": "npm run migrate --workspace apps/api",
    "deploy:sql:manual": "./deploy/scripts/deploy-sql.sh",
    "deploy:ec2:bootstrap": "./deploy/scripts/ec2-bootstrap.sh",
    "deploy:ec2:manual": "./deploy/scripts/ec2-deploy.sh",
    "test": "npx tsx tests/run-all.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "react-calendar": "^6.0.0"
  }
}
