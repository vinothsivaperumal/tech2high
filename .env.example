# Shared
NODE_ENV=production

# API
API_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tech2high_portal
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://your-ec2-public-ip:3000

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=tech2high-portal-assets
AWS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
AWS_SECURITY_GROUP_NAME=nit_tech2high_student_group
AWS_EC2_KEY_PAIR_NAME=your-keypair-name
AWS_EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Web
NEXT_PUBLIC_API_BASE_URL=http://your-ec2-public-ip:4000/api

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Tech2High Portal <your-gmail@gmail.com>
